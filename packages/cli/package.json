{
  "name": "@vite-pwa/workbox-cli",
  "type": "module",
  "version": "8.0.3",
  "description": "workbox-cli is the command line interface for Workbox.",
  "author": "Google's Web DevRel Team, Vite PWA's Team",
  "contributors": [
    "userquin <userquin@gmail.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/workbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/workbox.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/vite-pwa/workbox/issues",
  "keywords": [
    "workbox",
    "workboxjs",
    "service worker",
    "caching",
    "fetch requests",
    "offline",
    "cli"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "workbox-cli": "./bin/workbox-cli.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "test": "NO_COLOR=1 vitest",
    "test:ci": "NO_COLOR=1 vitest run",
    "test:typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "catalog:utils",
    "@vite-pwa/workbox-build": "workspace:*",
    "picocolors": "catalog:utils",
    "std-env": "catalog:utils"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
